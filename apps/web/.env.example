# Sandbox Genius Pay uniquement (docs officielles 10 sept. 2026).
# Jamais de clés *_live_*. Sans ces variables : DemoPaymentProvider.

# Option A — API marchand (https://geniuspay.ci/docs/api)
GENIUSPAY_API_KEY=pk_sandbox_
GENIUSPAY_API_SECRET=sk_sandbox_
GENIUSPAY_WEBHOOK_SECRET=whsec_sandbox_
GENIUSPAY_BASE_URL=https://geniuspay.ci/api/v1/merchant

# Option B — sandbox virtuel scénarios (https://geniuspay.ci/docs/sandbox)
# GENIUSPAY_API_KEY=sbx_test_
# GENIUSPAY_SANDBOX_URL=https://pay.genius.ci/sandbox
# GENIUSPAY_SANDBOX_SCENARIO=success

# MCP GeniusPay (Cursor : Settings > MCP > SSE)
# URL : https://geniuspay.ci/api/mcp
# Header : Authorization: Bearer <pk_sandbox_ ou sbx_test_>
# Ne jamais coller sk_live_ / pk_live_ dans Cursor.

# Optionnel — Next parle à FastAPI
# AFROSITE_API_URL=http://127.0.0.1:8000

# Optionnel — ledger FastAPI Postgres
# DATABASE_URL=postgresql://afrosite:afrosite_dev@localhost:5432/afrosite

# Génération LLM — une porte (`packages/llm`), pas dix SDK.
# Local : AI_GATEWAY_API_KEY. Vercel : OIDC (`vercel env pull`) suffit.
# Crédit Gateway : ~5 USD / mois / équipe (à confirmer dans le dashboard Vercel).
AI_GATEWAY_API_KEY=
AFROSITE_STUDIO_ACCESS_KEY=

# Alias de démarrage (docs AI Gateway). Confirmer avec :
#   pnpm --filter @afrosite/llm discover
AFROSITE_LLM_MODEL_LIGHT=anthropic/claude-haiku-4.5
AFROSITE_LLM_MODEL_REASONING=anthropic/claude-sonnet-4.6
AFROSITE_LLM_MODEL_CODE=openai/gpt-5.4
# AFROSITE_LLM_FALLBACK_LIGHT=google/gemini-3-flash,openai/gpt-5.4

# Backends interchangeables — un seul à la fois.
# AFROSITE_LLM_BACKEND=gateway
# AFROSITE_LLM_BACKEND=litellm
# LITELLM_PROXY_API_BASE=http://127.0.0.1:4000/v1
# LITELLM_PROXY_API_KEY=
# AFROSITE_LLM_BACKEND=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
