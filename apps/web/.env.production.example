# Afrosite web — production nationale
# Copier dans le gestionnaire de secrets de l’hébergeur, jamais dans Git.
AFROSITE_ENV=production
NEXT_PUBLIC_SITE_URL=https://app.example.bj
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-with-publishable-key

# Obligatoire si le web appelle FastAPI pour le catalogue, ledger et paiements.
AFROSITE_API_URL=https://api.example.bj

# Génération Studio côté serveur uniquement.
AI_GATEWAY_API_KEY=replace-with-server-secret
AFROSITE_STUDIO_ACCESS_KEY=replace-with-long-random-secret
AFROSITE_LLM_MODEL_LIGHT=openai/gpt-5.6-luna
AFROSITE_LLM_MODEL_REASONING=anthropic/claude-sonnet-5
AFROSITE_LLM_MODEL_CODE=openai/gpt-6-astra

# Paiement : utiliser le contrat PSP validé et les clés correspondant à l’environnement.
# Les clés live ne doivent jamais être exposées au navigateur.
GENIUSPAY_API_KEY=replace-with-provider-key
GENIUSPAY_API_SECRET=replace-with-provider-secret
GENIUSPAY_WEBHOOK_SECRET=replace-with-webhook-secret
GENIUSPAY_BASE_URL=https://geniuspay.ci/api/v1/merchant
