# Générer des valeurs aléatoires différentes (32 octets minimum).
# Ne jamais versionner le fichier .env réel.
AFROSITE_ENV=development
AFROSITE_AUTH_SECRET=remplacer-par-un-secret-aleatoire-de-32-octets-minimum
AFROSITE_AUTH_BOOTSTRAP_KEY=remplacer-par-une-cle-amorcage-aleatoire-distincte

# Optionnel : active le repository Postgres.
# DATABASE_URL=postgresql://afrosite:afrosite_dev@127.0.0.1:5432/afrosite
