# Application Environment
NODE_ENV=development
ENVIRONMENT=development
LOG_LEVEL=info

# Database (PostgreSQL)
POSTGRES_USER=afrosite
POSTGRES_PASSWORD=afrosite_dev_password
POSTGRES_DB=afrosite_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://afrosite:afrosite_dev_password@localhost:5432/afrosite_db

# Cache & Lock (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO / S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_DEFAULT_BUCKET=afrosite-assets
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=afrosite-assets

# Services Ports
API_PORT=8000
AGENTS_PORT=8001
WORKFLOWS_PORT=8002
WEB_PORT=3000

# API auth (never commit real secrets)
JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRE_MINUTES=60
DATABASE_URL=postgresql+asyncpg://afrosite:afrosite_dev_password@localhost:5432/afrosite_db
BOOTSTRAP_OWNER_EMAIL=owner@afrosite.example
BOOTSTRAP_OWNER_PASSWORD=change-me-owner
