# syntax=docker/dockerfile:1
FROM python:3.12-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/services/api:/app/packages/contracts/python
WORKDIR /app
RUN useradd --create-home --uid 10001 appuser
COPY pyproject.toml uv.lock .python-version ./
COPY services/api/pyproject.toml services/api/pyproject.toml
COPY services/agents/pyproject.toml services/agents/pyproject.toml
COPY services/workflows/pyproject.toml services/workflows/pyproject.toml
COPY packages/llm/pyproject.toml packages/llm/pyproject.toml
COPY packages/contracts packages/contracts
COPY services/api services/api
RUN pip install --no-cache-dir uv \
    && uv sync --frozen --package afrosite-api --no-dev
USER appuser
WORKDIR /app/services/api
EXPOSE 8000
CMD ["/app/.venv/bin/uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
